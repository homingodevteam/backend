# ---------------------------------------------------------------------------
# Template of every variable the app reads. THIS is the file that gets
# committed — .env, .env.local and .env.production are gitignored.
# Copy it to get started:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# local | production
NODE_ENV=local

APP_NAME=homingo-backend
API_PREFIX=api
API_VERSION=v1

PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# comma-separated origins, or * for all
CORS_ORIGIN=*

# --- AWS RDS (PostgreSQL) ------------------------------------------------
# !! THIS FILE IS COMMITTED TO GIT. Never put real credentials here. !!
# Put real values in .env / .env.local / .env.production, which are ignored.
#
# DB_HOST is the RDS endpoint: no port, no https://
DB_HOST=your-instance.abc123xyz.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
# QUOTE the password if it contains "#" — unquoted, dotenv reads "#" as the
# start of a comment and silently truncates the value, which shows up as
# "password authentication failed".  e.g.  DB_PASSWORD="Secret#123"
DB_PASSWORD=
DB_DATABASE=postgres

# Optional single-string alternative. When set it OVERRIDES the five fields
# above. Percent-encode any @ : / ? # in the password, otherwise the URL is
# invalid and the connection fails — e.g. a "#" must be written "%23".
DATABASE_URL=

# RDS requires TLS. Set DB_SSL_CA to the contents of
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# for full verification; otherwise leave reject=false.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=

# Never true in production — it drops columns to match entities.
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
