generator client {
  provider     = "prisma-client"
  // Prisma 7's documented convention — generating back into
  // node_modules/@prisma/client conflicts with the package skeleton that
  // `npm install @prisma/client` puts there. Every import in this codebase
  // goes through src/prisma/client.ts rather than pointing at this path
  // directly, so it only needs to be correct in one place.
  output       = "../generated/prisma"
  // Prisma 7 defaults to ESM output; this codebase (ts-node, nest build,
  // CommonJS throughout) needs CJS or every runtime entrypoint breaks with
  // "exports is not defined in ES module scope".
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// 01 · SERVICE CATALOG
// =====================================================================

model City {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  state    String
  timezone String
  isActive Boolean @default(true)

  addresses        CustomerAddress[]
  pros             Pro[]
  platformSettings PlatformSetting[]
  areas            Area[]

  @@index([isActive])
  @@map("cities")
}

/// A city subdivision — the unit service availability is defined against.
///
/// An axis-aligned **rectangle** in lat/lng, not a circle and not a polygon.
/// The shape is the whole point: rectangles **tile**. A generated grid covers a
/// city with no gaps and no overlap, which removes the entire class of problem
/// a circle model has to manage. See CONFLICTS_AND_DECISIONS #42.
///
/// **Bounds are half-open: `min <= value < max`.** That is what makes a pin
/// landing exactly on a shared edge belong to exactly one cell instead of two
/// or none, and floating-point coordinates land on shared edges more often
/// than intuition suggests, because adjacent cells are generated from the same
/// arithmetic.
///
/// Resolution is a plain indexed range query — no trigonometry, no loading
/// every area into memory. `haversineKm` still exists for dispatch's
/// travel-time ranking; it is simply not what decides an area any more.
///
/// Deliberately not PostGIS. The whole geometry question is confined to one
/// function (`resolveArea`), so a `geography(Polygon)` column can replace this
/// later without any caller changing.
model Area {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  name String

  /// Half-open on both axes: a point belongs when
  /// `minLat <= lat < maxLat AND minLng <= lng < maxLng`.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  isActive Boolean @default(true)

  areaServices AreaService[]
  proAreas     ProArea[]
  bookings     Booking[]

  @@unique([cityId, name])
  @@index([cityId, isActive])
  /// What `resolveArea` reads. Latitude leads because it is the more
  /// selective of the two across a city-sized grid.
  @@index([minLat, maxLat, minLng, maxLng])
  @@map("areas")
}

/// Which services are bookable in which area.
///
/// This is the row that makes "AC repair in Vijay Nagar but not Rau"
/// expressible at all — before it, serviceability was `City.isActive` and
/// nothing finer (CONFLICTS_AND_DECISIONS #8).
///
/// Availability only. Price stays national and per-service: there are still no
/// per-area price rows, and `Booking.flatPrice` is still snapshotted from
/// `Service.flatPrice`.
model AreaService {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId    String  @db.Uuid
  area      Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([areaId, serviceId])
  @@index([serviceId, isActive])
  @@map("area_services")
}

/// Which areas a Pro is posted to. Admin-set, like every other gate on a Pro.
///
/// A **filter on dispatch, never the ranking** — distance and travel time
/// still order the candidates. A Pro posted to Vijay Nagar may physically be
/// anywhere while travelling, and their live position is what dispatch scores;
/// this only says where they are expected to work.
model ProArea {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId  String @db.Uuid
  pro    Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)
  areaId String @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([proId, areaId])
  @@index([areaId, isActive])
  @@map("pro_areas")
}

/// The browse tree. Field names follow ERD v10 exactly.
/// Two levels only — a category is either a root (parentCategoryId = null) or
/// the child of a root; the depth bound is a service-layer rule, not a schema
/// one. See CONFLICTS_AND_DECISIONS #10.
model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  slug      String  @unique
  iconUrl   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parentCategoryId String?           @db.Uuid
  parentCategory   ServiceCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  ServiceCategory[] @relation("CategoryTree")

  services Service[]

  @@index([parentCategoryId, sortOrder])
  @@index([isActive])
  @@map("service_categories")
}

/// The unit of competency, of pricing and of booking. One flat national price
/// and one commission rate per service — no per-city rows, no tiers.
/// Field names follow ERD v10 exactly.
model Service {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?

  /// Feeds Dispatch slot sizing and ETA. Deliberately NOT a commission
  /// input — see CONFLICTS_AND_DECISIONS #7.
  durationMinutes Int
  /// The single customer-facing price, snapshotted onto Booking at creation
  /// (module 4). Serialises as a JSON string — CONFLICTS_AND_DECISIONS #12.
  flatPrice       Decimal @db.Decimal(12, 2)

  /// Nullable so a service can exist as a draft. Activation is gated on both
  /// being set — US-3.11: a live service with no rate leaves Pros unpaid.
  commissionType  String?
  commissionValue Decimal? @db.Decimal(12, 2)

  /// Which booking flows the customer app may offer for this service.
  supportsInstant   Boolean @default(true)
  supportsScheduled Boolean @default(true)
  supportsRecurring Boolean @default(false)

  /// Draft by default. Going live is an explicit, validated transition.
  isActive Boolean @default(false)

  /// Per-service cash gate (module 7, feature 11). Reverses
  /// CONFLICTS_AND_DECISIONS #13 — see #37 for why. Defaults to true so
  /// nothing that was bookable as cash before stops being so.
  allowsCash Boolean @default(true)

  proServices    ProService[]
  bookings       Booking[]
  recurringPlans RecurringPlan[]
  areaServices   AreaService[]

  @@index([categoryId, name])
  @@index([isActive])
  @@map("services")
}

// =====================================================================
// 02 · IDENTITY & ACCESS
// =====================================================================

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name            String  @unique
  description     String?
  permissionCodes Json    @default("[]")
  isSystemRole    Boolean @default(false)

  adminUsers AdminUser[]

  @@map("roles")
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone    String  @unique
  fullName String
  email    String?

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// City ids this admin may act on; empty array = platform-wide.
  cityScopeJson Json @default("[]")

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  aadhaarDocumentVerifications ProApplication[]   @relation("AadhaarDocumentVerifier")
  panDocumentVerifications     ProApplication[]   @relation("PanDocumentVerifier")
  platformSettingsUpdated      PlatformSetting[]
  overriddenBookings           Booking[]          @relation("BookingOverrideAdmin")
  approvedCommissionPayouts    CommissionPayout[] @relation("PayoutApprover")
  confirmedCashHandovers       CashHandover[]     @relation("CashHandoverConfirmer")
  refundedOrders               Order[]            @relation("OrderRefundInitiator")

  @@map("admin_users")
}

// =====================================================================
// 03 · CUSTOMER PROFILE
// =====================================================================

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stable per-install id — the guest identity before a phone is attached.
  deviceId String? @unique
  /// Null while guest; becomes the auth key once verified.
  phone    String? @unique
  /// Invoice delivery only — never a login credential.
  email    String?
  fullName String?

  status     String    @default("guest")
  verifiedAt DateTime?

  /// Populated later by the Payments module on first gateway checkout.
  razorpayCustomerId String? @unique

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  defaultAddressId String? @db.Uuid
  isBlocked        Boolean @default(false)

  addresses      CustomerAddress[]
  bookings       Booking[]
  recurringPlans RecurringPlan[]
  reviews        Review[]
  orders         Order[]

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String  @default("other")
  addressLine String
  landmark    String?

  /// Exact pinned coordinate — the Pro is routed to this, not the street text.
  pinLat Float
  pinLng Float

  /// GeoJSON Point, e.g. { type: 'Point', coordinates: [lng, lat] } — a
  /// convenience mirror for clients; pinLat/pinLng are what queries use.
  geoPoint Json?

  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  // NO areaId here, deliberately. It would be a cache of
  // resolveArea(pinLat, pinLng) that nothing maintains: the customers module
  // cannot reach module 13 without a dependency cycle, and booking re-resolves
  // from the pin anyway because areas get redrawn after an address is saved.
  // The app asks GET /geo/serviceability with the pin before saving, which
  // answers the same question without a column that can go stale.

  isDefault Boolean @default(false)

  bookings       Booking[]
  recurringPlans RecurringPlan[]

  @@index([customerId])
  @@index([cityId])
  @@map("customer_addresses")
}

// =====================================================================
// 04 · PRO MANAGEMENT
// =====================================================================

/// Three gates to dispatchability, all admin-set: status = approved, at
/// least one active ProService, isAvailable = true.
model Pro {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone String @unique

  /// Legal identity copied from the approved KYC application. Pro
  /// self-service endpoints never write these fields.
  fullName    String?
  dateOfBirth DateTime? @db.Date
  gender      String?

  profilePhotoUrl String?
  email           String?
  languages       Json    @default("[]")

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  /// Human-readable home-base address. Coordinates remain authoritative.
  addressLine String?

  /// Payroll identity — payroll itself is external to this system.
  employeeCode    String?   @unique
  /// Bookkeeping only — this system never pays salary, only commission.
  monthlySalary   Decimal?  @db.Decimal(12, 2)
  salaryUpdatedAt DateTime?

  status String @default("applied")

  approvedApplicationId String?         @unique @db.Uuid
  approvedApplication   ProApplication? @relation("ApprovedApplication", fields: [approvedApplicationId], references: [id], onDelete: SetNull)

  /// GATE: on/off duty. Set only by an admin, never by the Pro.
  isAvailable           Boolean   @default(false)
  availabilityUpdatedAt DateTime?

  pushToken          String?
  pushPlatform       String?
  pushTokenUpdatedAt DateTime?

  homeBaseLat Float?
  homeBaseLng Float?

  /// Cold fallback only — live position lives in Redis GEO (Geo & Routing).
  lastKnownLat   Float?
  lastKnownLng   Float?
  lastLocationAt DateTime?

  cityId String? @db.Uuid
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  // Exact integer counters, rebuilt nightly once Reviews/Dispatch exist.
  // Nothing in this pass writes them — declared for column shape only.
  ratingSum               Int       @default(0)
  ratingCount             Int       @default(0)
  assignmentsOffered      Int       @default(0)
  assignmentsAcknowledged Int       @default(0)
  /// Analytics only — never a ranking or pay input.
  acceptanceRate          Float?
  completedJobs           Int       @default(0)
  countersRebuiltAt       DateTime?

  /// Banknotes this Pro is currently carrying on the platform's behalf.
  ///
  /// A **cache of the ledger**, in exactly the relationship `completedJobs`
  /// has to `Booking` — module 9's nightly rebuild is what makes it
  /// authoritative. It exists as a column because dispatch gates on it
  /// (feature 16) and cannot afford a ledger aggregate per candidate.
  ///
  /// Moved by exactly two operations: a cash collection and a **confirmed**
  /// handover. Commission is never netted against it — feature 15.
  cashInHand Decimal @default(0) @db.Decimal(12, 2)

  /// Employment start date.
  approvedAt DateTime?

  applications         ProApplication[]      @relation("ProApplications")
  services             ProService[]
  bankAccounts         ProBankAccount[]
  bookings             Booking[]
  startOtpVerifiedJobs Booking[]             @relation("BookingStartOtpVerifier")
  photoProofs          JobPhotoProof[]
  assignmentCandidates AssignmentCandidate[]
  reviews              Review[]
  commissions          BookingCommission[]
  payouts              CommissionPayout[]
  cashHandovers        CashHandover[]
  areas                ProArea[]

  @@index([status])
  @@index([isAvailable])
  @@index([cityId])
  @@map("pros")
}

/// One row per attempt — a rejected Pro re-applying creates a new row, the
/// old one and its documents are preserved. Pro.approvedApplicationId points
/// at whichever row actually succeeded.
model ProApplication {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation("ProApplications", fields: [proId], references: [id], onDelete: Cascade)

  referredByType String  @default("none")
  referredById   String?

  submittedAt DateTime?
  queueStatus String    @default("pending")

  /// Legal identity captured from this specific KYC attempt. A rejected Pro
  /// may submit corrected values in the next application; approval copies
  /// this snapshot to Pro and locks it from Pro self-service edits.
  documentFullName    String?
  documentDateOfBirth DateTime? @db.Date
  documentGender      String?

  // Aadhaar — independently sourced and verified from PAN.
  aadhaarSource            String?
  aadhaarUrl               String?
  aadhaarNumberMasked      String?
  aadhaarStatus            String     @default("pending")
  /// Actor is explicit: type=system has no admin id; type=admin requires one.
  aadhaarVerifiedByType    String?
  aadhaarVerifiedByAdminId String?    @db.Uuid
  aadhaarVerifiedByAdmin   AdminUser? @relation("AadhaarDocumentVerifier", fields: [aadhaarVerifiedByAdminId], references: [id], onDelete: Restrict)
  aadhaarVerifiedAt        DateTime?
  aadhaarRejectionReason   String?

  // PAN — independent of aadhaarSource.
  panSource            String?
  panUrl               String?
  panNumberMasked      String?
  panStatus            String     @default("pending")
  panVerifiedByType    String?
  panVerifiedByAdminId String?    @db.Uuid
  panVerifiedByAdmin   AdminUser? @relation("PanDocumentVerifier", fields: [panVerifiedByAdminId], references: [id], onDelete: Restrict)
  panVerifiedAt        DateTime?
  panRejectionReason   String?

  reviewedByAdminId  String?
  verificationCallAt DateTime?

  decision        String?
  decisionAt      DateTime?
  rejectionReason String?

  approvedByPro Pro? @relation("ApprovedApplication")

  @@index([proId])
  @@index([queueStatus])
  @@index([aadhaarVerifiedByAdminId])
  @@index([panVerifiedByAdminId])
  @@map("pro_applications")
}

/// ProService(proId, serviceId) is the single source of truth for skill
/// matching. A Service is the unit of competency; there is no separate skill
/// code.
model ProService {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  proficiency String    @default("trainee")
  certifiedAt DateTime?
  /// Suspend one service without suspending the whole Pro.
  isActive    Boolean   @default(true)

  @@unique([proId, serviceId])
  @@index([proId])
  @@index([serviceId])
  @@map("pro_services")
}

model ProBankAccount {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Cascade)

  accountHolderName   String
  accountNumberMasked String
  ifscCode            String
  upiId               String?

  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  payouts CommissionPayout[]

  @@index([proId])
  @@map("pro_bank_accounts")
}

// =====================================================================
// 04 · BOOKING & JOB LIFECYCLE
// =====================================================================

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingNumber String          @unique
  customerId    String          @db.Uuid
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId     String          @db.Uuid
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addressId     String          @db.Uuid
  address       CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// The area this booking was sold into, frozen at creation for the same
  /// reason `flatPrice` is: areas get redrawn, and a booking must keep saying
  /// where it was taken. Null on every booking predating areas, and on one
  /// whose pin fell outside all of them.
  areaId String? @db.Uuid
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// instant | scheduled | recurring
  bookingType String @default("instant")

  recurringPlanId String?        @db.Uuid
  recurringPlan   RecurringPlan? @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)

  rebookedFromBookingId String?   @db.Uuid
  rebookedFrom          Booking?  @relation("Rebook", fields: [rebookedFromBookingId], references: [id], onDelete: SetNull)
  rebookedInto          Booking[] @relation("Rebook")

  /// Set for every booking, including instant ones: slotEnd - slotStart is the
  /// expected duration the job was sold against, so a later edit to
  /// Service.durationMinutes cannot retroactively resize it (US-3.6).
  slotStartAt DateTime?
  slotEndAt   DateTime?

  /// Frozen at creation from Service.flatPrice. Never recomputed from the live
  /// catalogue — US-3.2, US-3.5.
  flatPrice Decimal @db.Decimal(12, 2)

  /// online | cash — FROZEN at creation. Forks the state machine: a cash
  /// booking skips awaiting_payment and has no Order row at all.
  paymentMode   String @default("cash")
  /// unpaid | authorized | paid | refunded. For cash, "paid" means a Pro is
  /// carrying banknotes — read paymentMode beside it.
  ///
  /// Written once here at creation; module 7 is its only other writer.
  paymentStatus String @default("unpaid")

  /// CASH ONLY — the store of record for a cash booking, which has no Order
  /// row (CONFLICTS_AND_DECISIONS #36). Not an input: it is `flatPrice` or it
  /// is null. A Pro cannot record a part payment.
  cashCollectedAmount Decimal?  @db.Decimal(12, 2)
  cashCollectedAt     DateTime?
  /// Set when the customer refuses to pay. The job still completes and the
  /// Pro is still paid their commission — feature 17.
  cashDeclinedAt      DateTime?
  cashDeclinedReason  String?

  status String  @default("created")
  proId  String? @db.Uuid
  pro    Pro?    @relation(fields: [proId], references: [id], onDelete: Restrict)

  assignmentAttempt Int       @default(0)
  assignedAt        DateTime?
  notifiedAt        DateTime?
  ackDeadlineAt     DateTime?
  acknowledgedAt    DateTime?
  assignmentOutcome String?

  overriddenByAdminId String?    @db.Uuid
  overriddenByAdmin   AdminUser? @relation("BookingOverrideAdmin", fields: [overriddenByAdminId], references: [id], onDelete: SetNull)
  overrideReason      String?

  arrivedAt DateTime?

  /// The trust anchor. Only a provider-verified OTP (or an audited ops
  /// force-start) may set startedAt — never the app's own claim.
  startOtpProviderRef     String?
  startOtpAttempts        Int     @default(0)
  startOtpVerifiedByProId String? @db.Uuid
  startOtpVerifiedByPro   Pro?    @relation("BookingStartOtpVerifier", fields: [startOtpVerifiedByProId], references: [id], onDelete: SetNull)

  startedAt             DateTime?
  completedAt           DateTime?
  /// Computed from verified start to completion. REPORTING ONLY — commission
  /// is one flat rate per service. See CONFLICTS_AND_DECISIONS #7 and #18.
  actualDurationMinutes Int?
  /// Sampled polyline, written ONCE at completion. Never appended per ping.
  routeTrail            Json?

  /// The invoice is an artifact of the booking, not a table.
  invoiceNumber String?   @unique
  invoicePdfUrl String?
  taxAmount     Decimal?  @db.Decimal(12, 2)
  invoicedAt    DateTime?

  cancelledAt           DateTime?
  cancelReason          String?
  /// customer | ops | system. Never `pro` — a Pro cannot cancel.
  cancelledByType       String?
  cancellationFeeAmount Decimal?  @db.Decimal(12, 2)
  refundedAmount        Decimal?  @db.Decimal(12, 2)

  assignmentCandidates AssignmentCandidate[]
  statusEvents         BookingStatusEvent[]
  chatMessages         ChatMessage[]
  photoProofs          JobPhotoProof[]
  review               Review?
  commission           BookingCommission?
  /// Online only, and plural: an expired or voided order is reissued rather
  /// than mutated, so the gateway history stays readable by receipt.
  orders               Order[]

  @@index([proId, status])
  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([addressId, proId, completedAt])
  @@index([status, slotStartAt])
  // "How much work came out of Vijay Nagar this month" — the question areas
  // exist to make answerable.
  @@index([areaId, createdAt])
  @@map("bookings")
}

/// Generates future bookings on a schedule. Each occurrence is priced when it
/// is generated, not when the plan was made — CONFLICTS_AND_DECISIONS #21.
model RecurringPlan {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String          @db.Uuid
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String          @db.Uuid
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addressId  String          @db.Uuid
  address    CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// daily | weekly | biweekly | monthly
  frequency  String
  /// [0..6], Sunday = 0. Only meaningful for weekly/biweekly.
  daysOfWeek Json   @default("[]")
  /// Wall-clock "HH:mm", interpreted in the booking city's timezone.
  timeOfDay  String

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  /// The generator's cursor: the instant the next occurrence is due.
  nextRunAt DateTime?
  isActive  Boolean   @default(true)

  bookings Booking[]

  @@index([isActive, nextRunAt])
  @@index([customerId])
  @@map("recurring_plans")
}

/// Customer ↔ assigned Pro, scoped to one booking. Neither side ever sees the
/// other's phone number. Survives completion as dispute evidence (US-4.24).
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// customer | pro. Ops reads the thread but never joins it.
  senderType    String
  senderId      String    @db.Uuid
  body          String
  attachmentUrl String?
  sentAt        DateTime  @default(now())
  readAt        DateTime?

  @@index([bookingId, sentAt])
  @@map("chat_messages")
}

/// Geo-stamped evidence, not decoration. At least one `completion` row is
/// required before a job can be completed (US-4.16).
model JobPhotoProof {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proId     String  @db.Uuid
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)

  /// before | after | completion
  photoType  String
  photoUrl   String
  lat        Float?
  lng        Float?
  capturedAt DateTime @default(now())

  @@index([bookingId, photoType])
  @@map("job_photo_proofs")
}

// =====================================================================
// 07 · PAYMENTS — RAZORPAY ORDERS AND CASH
// =====================================================================
//
// ONLINE BOOKINGS ONLY. A cash booking has no Order row at all, which means
// any report joining Order silently undercounts every cash job — the single
// most likely bug this module can cause (CONFLICTS_AND_DECISIONS #36).
//
// There is no Payment table and there will not be one. Attempt-level detail —
// every try, its failure code, the method used — lives at Razorpay and is read
// in THEIR dashboard by razorpayOrderId. Only what the platform must join or
// reconcile on is here. In exchange, there is no local copy of payment data to
// drift out of sync with the gateway.

model Order {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A booking may have several orders — expired, voided, reissued.
  bookingId  String   @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// The key for every gateway lookup, support's included.
  razorpayOrderId String @unique
  /// Our reference sent to Razorpay: `<bookingNumber>-<n>`.
  receipt         String @unique

  /// Rupees, like every other money column here. Razorpay transacts in
  /// integer paise — the conversion lives in payments.money.ts and nowhere
  /// else.
  amount     Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  amountDue  Decimal @db.Decimal(12, 2)
  currency   String  @default("INR")

  /// created | attempted | paid — FORWARD ONLY. Razorpay does not guarantee
  /// webhook ordering, so a late `authorized` must not undo a `captured`.
  status String @default("created")

  /// Mirrors of the gateway for triage only. `attempts` is Razorpay's own
  /// counter and `failureCode` is the LAST failure, not a history.
  attempts    Int     @default(0)
  failureCode String?

  /// The successful attempt's reference — written once and never overwritten.
  /// A second, different payment id against a paid order is a duplicate-charge
  /// signal, not an update.
  capturedPaymentId String?   @unique
  paymentMethod     String?
  paidAt            DateTime?

  /// rzp notes echoed back: bookingId, serviceId, cityId. What makes a
  /// gateway-side row traceable to a booking without our database.
  notesJson Json?

  /// CUMULATIVE across refunds, never per-refund.
  refundAmount     Decimal?  @db.Decimal(12, 2)
  razorpayRefundId String?
  /// none | initiated | settled | failed — forward only, except that `failed`
  /// is terminal for the attempt and leaves refundAmount standing.
  refundStatus     String    @default("none")
  refundedAt       DateTime?

  refundInitiatedByAdminId String?    @db.Uuid
  refundInitiatedByAdmin   AdminUser? @relation("OrderRefundInitiator", fields: [refundInitiatedByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([refundStatus])
  @@map("orders")
}

/// The only thing that clears a Pro's cash balance.
///
/// Recovery is by handover, never by netting: the Pro declares, an admin
/// confirms, and only the confirmation moves `Pro.cashInHand`. Commission is
/// untouched throughout — a Pro who owes cash is still paid in full, which is
/// why a Pro who stops handing over accumulates indefinitely and no arithmetic
/// notices (CONFLICTS_AND_DECISIONS #36).
model CashHandover {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId String @db.Uuid
  pro   Pro    @relation(fields: [proId], references: [id], onDelete: Restrict)

  /// What the Pro says they are handing over.
  declaredAmount Decimal  @db.Decimal(12, 2)
  declaredAt     DateTime @default(now())

  /// declared | confirmed | rejected
  status String @default("declared")

  /// What the admin actually counted. Deliberately allowed to differ from
  /// `declaredAmount` — the variance is the point of counting, and it is
  /// never silently reconciled away.
  confirmedAmount    Decimal?   @db.Decimal(12, 2)
  confirmedAt        DateTime?
  confirmedByAdminId String?    @db.Uuid
  confirmedByAdmin   AdminUser? @relation("CashHandoverConfirmer", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)

  rejectionReason String?
  notes           String?

  @@index([proId, status])
  @@index([status, declaredAt])
  @@map("cash_handovers")
}

// =====================================================================
// 05-10 · MINIMUM SOURCE MODELS REQUIRED BY PRO LIFECYCLE & STANDING
// =====================================================================

model AssignmentCandidate {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId     String  @db.Uuid
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attemptNumber Int
  proId         String  @db.Uuid
  pro           Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)
  isWinner      Boolean @default(false)

  /// The free window this Pro had, computed from committed bookings alone.
  windowStart DateTime?
  windowEnd   DateTime?

  /// Where the engine routed them from — current_location | last_job_location
  /// | home_base. Recorded so US-5.7 stays answerable after the fact.
  originType String?
  originLat  Float?
  originLng  Float?

  /// Null means excluded before scoring. US-5.11: a Pro who was never a
  /// candidate must be distinguishable from one who ranked and lost.
  rank              Int?
  distanceKm        Float?
  travelTimeMinutes Int?
  rotationScore     Float?
  durationFitScore  Float?
  /// Smoothed, not the Pro's displayed rating — a 5.0 from two reviews can
  /// legitimately lose to a 4.6 from two hundred.
  ratingScore       Float?
  offersToday       Int?
  finalRankScore    Float?

  /// unavailable | no_service | out_of_range | rotation_cooldown | already_tried
  excludedReason String?
  evaluatedAt    DateTime @default(now())

  @@unique([bookingId, attemptNumber, proId])
  @@index([proId, isWinner])
  /// Ops opens this by booking, newest attempt first — US-5.9 / US-5.11.
  @@index([bookingId, attemptNumber, rank])
  @@map("assignment_candidates")
}

model BookingStatusEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  actorType String
  actorId   String

  /// Where the actor actually was at the transition — dispute and SOS
  /// evidence. Float, matching every other coordinate in this schema; see
  /// CONFLICTS_AND_DECISIONS #19.
  lat Float?
  lng Float?

  occurredAt DateTime @default(now())

  @@index([bookingId, occurredAt])
  @@index([actorType, actorId, status])
  @@map("booking_status_events")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId  String   @unique @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  proId      String   @db.Uuid
  pro        Pro      @relation(fields: [proId], references: [id], onDelete: Restrict)

  rating       Int
  comment      String?
  tags         Json    @default("[]")
  isHidden     Boolean @default(false)
  hiddenReason String?

  @@index([proId, createdAt])
  @@map("reviews")
}

model BookingCommission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  proId     String  @db.Uuid
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Restrict)

  customerFlatAmount    Decimal  @db.Decimal(12, 2)
  actualDurationMinutes Int?
  commissionType        String
  commissionValue       Decimal  @db.Decimal(12, 2)
  commissionAmount      Decimal  @db.Decimal(12, 2)
  platformAmount        Decimal  @db.Decimal(12, 2)
  incentiveAmount       Decimal  @default(0) @db.Decimal(12, 2)
  deductionAmount       Decimal  @default(0) @db.Decimal(12, 2)
  netPayable            Decimal  @db.Decimal(12, 2)
  status                String   @default("pending")
  computedAt            DateTime @default(now())

  payoutId String?           @db.Uuid
  payout   CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([proId, computedAt])
  @@index([payoutId])
  @@map("booking_commissions")
}

model CommissionPayout {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proId         String         @db.Uuid
  pro           Pro            @relation(fields: [proId], references: [id], onDelete: Restrict)
  bankAccountId String         @db.Uuid
  bankAccount   ProBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  periodStart       DateTime   @db.Date
  periodEnd         DateTime   @db.Date
  commissionAmount  Decimal    @db.Decimal(12, 2)
  incentiveAmount   Decimal    @default(0) @db.Decimal(12, 2)
  deductionAmount   Decimal    @default(0) @db.Decimal(12, 2)
  netAmount         Decimal    @db.Decimal(12, 2)
  status            String     @default("draft")
  approvedByAdminId String?    @db.Uuid
  approvedByAdmin   AdminUser? @relation("PayoutApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  paidAt            DateTime?
  payoutReference   String?

  commissions BookingCommission[]

  @@index([proId, periodEnd])
  @@map("commission_payouts")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key              String
  cityId           String?    @db.Uuid
  city             City?      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  value            String
  description      String?
  updatedByAdminId String?    @db.Uuid
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([key, cityId])
  @@index([cityId, key])
  @@map("platform_settings")
}
